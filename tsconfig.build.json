{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"declarationDir": "dist/types",
		"emitDeclarationOnly": true
	},
	"exclude": [
		"node_modules",
		"dist",
		"example",
		"docs",
		"src/**/*.test.*",
		"src/**/*.stories.*",
		"**/__tests__/**"
	]
}
