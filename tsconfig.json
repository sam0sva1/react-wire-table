{
	"compilerOptions": {
		"outDir": "dist",
		"module": "esnext",
		"target": "es2017",
		"lib": ["es2017", "dom"],
		"sourceMap": true,
		"jsx": "react-jsx",
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"strict": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"build-tool",
		"dist",
		"example",
		"docs",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.stories.tsx"
	]
}
