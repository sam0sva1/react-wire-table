{
	"name": "react-wire-table",
	"homepage": "https://sam0sva1.github.io/react-wire-table",
	"version": "0.1.3",
	"description": "A lightweight, sortable React table component with TypeScript support",
	"repository": {
		"type": "git",
		"url": "https://github.com/sam0sva1/react-wire-table"
	},
	"main": "dist/cjs/index.js",
	"module": "dist/es/index.js",
	"style": "dist/react-wire-table.css",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./styles.css": "./dist/react-wire-table.css"
	},
	"sideEffects": [
		"*.css"
	],
	"author": {
		"name": "sam0sva1",
		"email": "konstantus@live.ru"
	},
	"scripts": {
		"build": "rollup -c rollup.config.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"pre-publish": "npm run typecheck && npm run lint && npm run test && npm run build"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"react": ">=17.0.0",
		"react-dom": ">=17.0.0"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"classifizer": "^1.0.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.0",
		"@rollup/plugin-typescript": "^12.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"eslint": "^9.18.0",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"jsdom": "^25.0.0",
		"prettier": "^3.4.0",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"rollup": "^4.0.0",
		"rollup-plugin-peer-deps-external": "^2.2.0",
		"rollup-plugin-postcss": "^4.0.0",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.20.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"react",
		"table",
		"wire-table",
		"react-table",
		"sortable-table",
		"typescript"
	]
}
